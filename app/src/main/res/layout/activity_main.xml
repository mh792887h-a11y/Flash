<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true"
    android:padding="24dp">

    <!-- Title: كلمة «فلاش» باللون الأبيض -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="48dp"
        android:text="@string/flash_word"
        android:textColor="#FFFFFF"
        android:textSize="40sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.05" />

    <!-- Big Center Circular Button: زر واحد كبير لتشغيل الفلاش وإطفائه -->
    <FrameLayout
        android:id="@+id/btn_flash_toggle"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_button_off"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/desc_flash_toggle"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/iv_flash_icon"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_flashlight_off"
            android:contentDescription="@string/desc_flash_toggle" />
    </FrameLayout>

    <!-- Error message text only displayed if critical hardware/permission error occurs -->
    <TextView
        android:id="@+id/tv_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:textColor="#FF5252"
        android:textSize="14sp"
        android:visibility="gone" />

</RelativeLayout>
